.backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: flex-end;
    align-items: stretch;
}

.entity-info-panel {
    width: 320px;
    height: 100%;
    background-color: rgba(18, 18, 24, 0.92);
    border-left-width: 2px;
    border-left-color: rgba(100, 180, 255, 0.4);
    padding: 16px;
    flex-shrink: 0;
    flex-direction: column;
}

.panel-title {
    font-size: 20px;
    color: rgb(220, 230, 255);
    -unity-font-style: bold;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(100, 180, 255, 0.25);
}

.panel-content {
    flex-direction: column;
    flex-grow: 1;
}

.panel-label {
    color: rgb(220, 230, 255);
    margin-top: 6px;
}

.panel-button {
    height: 36px;
    margin-top: 8px;
}

.panel-delete-button {
    color: rgb(255, 220, 220);
    background-color: rgba(170, 45, 45, 0.95);
}
