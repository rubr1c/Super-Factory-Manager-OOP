.inventory-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 88px;
}

.inventory-panel {
    flex-direction: column;
    align-items: center;
}

.inventory-row {
    flex-direction: row;
    justify-content: center;
}

.hotbar-root {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    padding-bottom: 16px;
}

.hotbar-slot {
    width: 56px;
    height: 56px;
    margin: 3px;
    background-color: rgba(40, 42, 54, 0.85);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(100, 180, 255, 0.2);
    align-items: center;
    justify-content: center;
    padding: 4px;
}

.hotbar-slot:hover {
    border-color: rgba(100, 180, 255, 0.6);
    background-color: rgba(60, 64, 80, 0.9);
}

.menu-slot {
    border-color: rgba(100, 180, 255, 0.35);
    background-color: rgba(30, 32, 44, 0.9);
}

.menu-slot:hover {
    border-color: rgba(100, 180, 255, 0.7);
    background-color: rgba(50, 55, 70, 0.95);
}

.menu-label {
    flex-grow: 1;
    align-self: stretch;
    width: 100%;
    height: 100%;
    font-size: 20px;
    color: rgba(180, 195, 220, 0.7);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
